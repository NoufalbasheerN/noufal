# =====================================================
# HELPERS
# =====================================================


def format_timer(minutes, msec):
    total_seconds = minutes * 60 + (msec // 1000)
    hh = total_seconds // 3600
    mm = (total_seconds % 3600) // 60
    ss = total_seconds % 60
    return f"{hh:02d}:{mm:02d}:{ss:02d}"


def seconds_from_timer(minutes, msec):
    return minutes * 60 + msec // 1000


def hms(total_seconds):
    hh = total_seconds // 3600
    mm = (total_seconds % 3600) // 60
    ss = total_seconds % 60
    return f"{hh:02d}:{mm:02d}:{ss:02d}"


def safe_insert(document):
    try:
        collection.insert_one(document)
        return True
    except PyMongoError as e:
        log.error(f"Mongo insert failed: {e}")
        return False


# =====================================================
# CONNECTION MANAGEMENT (with reconnect support)
# =====================================================

handles = {}  # machine_name -> ctypes.c_ushort


def connect_machine(machine):
    handle = ctypes.c_ushort()
    ret = focas.cnc_allclibhndl3(machine["ip"], 8193, 10, ctypes.byref(handle))
    if ret == 0:
        handles[machine["name"]] = handle
        log.info(f"{machine['name']} Connected")
        return True
    else:
        log.warning(f"{machine['name']} Connect failed : {ret}")
        return False


def disconnect_all():
    for name, handle in handles.items():
        try:
            focas.cnc_freelibhndl(handle.value)
        except Exception as e:
            log.error(f"Error freeing handle for {name}: {e}")
    handles.clear()


for m in MACHINES:
    connect_machine(m)


def shutdown(*_):
    log.info("Shutting down, releasing FOCAS handles...")
    disconnect_all()
    sys.exit(0)


signal.signal(signal.SIGINT, shutdown)
signal.signal(signal.SIGTERM, shutdown)

# =====================================================
# CYCLE TRACKING STATE
# =====================================================

previous_state = {m["name"]: "UNKNOWN" for m in MACHINES}
cycle_start_time = {m["name"]: None for m in MACHINES}
machine_on_count = {m["name"]: 0 for m in MACHINES}
machine_off_count = {m["name"]: 0 for m in MACHINES}

RECONNECT_ERROR_CODES = {-16, -8, 3}  # EW_HANDLE / EW_SOCKET / connection-ish errors; adjust to your FOCAS error map

# =====================================================
# MAIN LOOP
# =====================================================

while True:

    for machine in MACHINES:

        machine_name = machine["name"]

        if machine_name not in handles:
            # Attempt reconnect for any machine that's currently down.
            connect_machine(machine)
            if machine_name not in handles:
                continue

        handle = handles[machine_name]

        try:
            # ---------------- PART COUNT ----------------
            part = ODBM()
            ret = focas.cnc_rdmacro(handle.value, 3901, 10, ctypes.byref(part))
            part_count = (
                int(part.mcr_val / (10 ** abs(part.dec_val))) if ret == 0 else -1
            )

            # ---------------- TARGET COUNT ----------------
            target = ODBM()
            ret = focas.cnc_rdmacro(handle.value, 3902, 10, ctypes.byref(target))
            target_count = (
                int(target.mcr_val / (10 ** abs(target.dec_val))) if ret == 0 else -1
            )

            # ---------------- STATUS ----------------
            status = ODBST()
            ret = focas.cnc_statinfo(handle.value, ctypes.byref(status))
            if ret == 0:
                machine_state = "RUNNING" if status.motion == 3 else "STOPPED"
                alarm = status.alarm
            else:
                machine_state = "UNKNOWN"
                alarm = -1

            # ---------------- TIMERS ----------------
            timer0 = IODBTIME()
            ret0 = focas.cnc_rdtimer(handle.value, 0, ctypes.byref(timer0))
            power_on = format_timer(timer0.minute, timer0.msec) if ret0 == 0 else "NA"

            timer1 = IODBTIME()
            ret1 = focas.cnc_rdtimer(handle.value, 1, ctypes.byref(timer1))
            run_time = format_timer(timer1.minute, timer1.msec) if ret1 == 0 else "NA"

            timer2 = IODBTIME()
            ret2 = focas.cnc_rdtimer(handle.value, 2, ctypes.byref(timer2))
            cutting_time = (
                format_timer(timer2.minute, timer2.msec) if ret2 == 0 else "NA"
            )

            timer3 = IODBTIME()
            ret3 = focas.cnc_rdtimer(handle.value, 3, ctypes.byref(timer3))
            cycle_time = (
                format_timer(timer3.minute, timer3.msec) if ret3 == 0 else "NA"
            )

            current_time = datetime.now()

            # ---------------- CYCLE START ----------------
            if previous_state[machine_name] != "RUNNING" and machine_state == "RUNNING":
                cycle_start_time[machine_name] = current_time
                machine_on_count[machine_name] += 1

            # ---------------- CYCLE STOP ----------------
            elif (
                previous_state[machine_name] == "RUNNING"
                and machine_state == "STOPPED"
            ):
                machine_off_count[machine_name] += 1

                if cycle_start_time[machine_name]:
                    cycle_stop_time = current_time
                    cycle_seconds = int(
                        (cycle_stop_time - cycle_start_time[machine_name]).total_seconds()
                    )
                    actual_cycle_time = hms(cycle_seconds)

                    power_seconds = seconds_from_timer(timer0.minute, timer0.msec) if ret0 == 0 else 0
                    run_seconds = seconds_from_timer(timer1.minute, timer1.msec) if ret1 == 0 else 0
                    down_seconds = max(power_seconds - run_seconds, 0)
                    machine_down_time = hms(down_seconds)

                    document = {
                        "timestamp": current_time,
                        "machine_name": machine_name,
                        "cycle_start": cycle_start_time[machine_name],
                        "cycle_stop": cycle_stop_time,
                        "machine_cycle_time": actual_cycle_time,
                        "machine_down_time": machine_down_time,
                        "overall_run_time": run_time,
                        "total_part_count": part_count,
                        "ok_part_count": part_count,
                        "not_ok_part_count": 0,
                        "machine_on_count": machine_on_count[machine_name],
                        "machine_off_count": machine_off_count[machine_name],
                        "target_count": target_count,
                        "alarm": alarm,
                    }

                    if safe_insert(document):
                        log.info(f"{machine_name} Cycle Saved")

            previous_state[machine_name] = machine_state

            log.info(
                f"[{machine_name}] state={machine_state} part={part_count} "
                f"target={target_count} alarm={alarm} power_on={power_on} "
                f"run={run_time} cutting={cutting_time} cycle={cycle_time}"
            )

            # If the CNC call returned a connection-level error, drop and
            # reconnect next cycle rather than keep hammering a dead handle.
            if ret in RECONNECT_ERROR_CODES:
                log.warning(f"{machine_name} looks disconnected (ret={ret}), will retry")
                try:
                    focas.cnc_freelibhndl(handle.value)
                except Exception:
                    pass
                del handles[machine_name]

        except Exception as e:
            log.error(f"{machine_name} Error : {e}", exc_info=True)

    time.sleep(5)
            
