# =====================================================
# STRUCTURES  (fixed to match real FOCAS layouts)
# =====================================================


class ODBM(ctypes.Structure):
    """Used with cnc_rdmacro (macro variable read)."""
    _pack_ = 1
    _fields_ = [
        ("datano", ctypes.c_int16),
        ("dummy", ctypes.c_int16),
        ("mcr_val", ctypes.c_int32),
        ("dec_val", ctypes.c_int16),
    ]


class ODBST(ctypes.Structure):
    """
    Used with cnc_statinfo.

    FIX: the real FOCAS struct has 9 short fields, not 8.
    The original code was missing `tmmode`, which made this
    struct 2 bytes smaller than what cnc_statinfo actually
    writes -> heap buffer overflow -> segfault.
    """
    _pack_ = 1
    _fields_ = [
        ("dummy", ctypes.c_short),
        ("tmmode", ctypes.c_short),
        ("aut", ctypes.c_short),
        ("run", ctypes.c_short),
        ("motion", ctypes.c_short),
        ("mstb", ctypes.c_short),
        ("emergency", ctypes.c_short),
        ("alarm", ctypes.c_short),
        ("edit", ctypes.c_short),
    ]


class IODBTIME(ctypes.Structure):
    """Used with cnc_rdtimer."""
    _pack_ = 1
    _fields_ = [
        ("minute", ctypes.c_int32),
        ("msec", ctypes.c_int32),
    ]


